# ─────────────────────────────────────────────────────────────────────────
# Environment variables for jack-portfolio
#
# Copy this file to `.env.local` (git-ignored) and fill in real values.
# Vite only exposes variables prefixed with VITE_ to client-side code, so
# ONLY put values here that are safe to ship in the browser bundle.
# Anything WITHOUT the VITE_ prefix is never read by the browser and must
# only ever be used from a trusted server context (e.g. a serverless
# function, edge function, or build script) — never imported from src/.
# ─────────────────────────────────────────────────────────────────────────

# ── Supabase (client-safe) ─────────────────────────────────────────────
# Project URL and anonymous/public key. These are safe to expose in the
# browser — access to data is controlled by Supabase Row Level Security
# (RLS) policies, not by keeping this key secret.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ── Supabase (SERVER-SIDE ONLY — never prefix with VITE_) ─────────────
# The service-role key bypasses Row Level Security entirely. It must
# NEVER be imported into any file under src/, never shipped to the
# client bundle, and only ever used from a trusted backend/serverless
# environment (e.g. Supabase Edge Functions, a Vercel serverless
# function) for privileged admin operations.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Cloudinary (client-safe) ────────────────────────────────────────────
# Cloud name is a public identifier (it appears in every delivered image
# URL) and is safe to expose. All uploads are SIGNED — see the
# server-side section below — so no unsigned upload preset is needed.
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# ── Cloudinary (SERVER-SIDE ONLY — never prefix with VITE_) ───────────
# The API key/secret pair allows signed, privileged operations (uploads,
# deletes, admin API access). Read only by the Vercel serverless
# functions under /api — never import these into src/ or any
# client-bundled code.
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
